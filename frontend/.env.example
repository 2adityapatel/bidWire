# Frontend Environment Variables

# Backend URLs for Multi-Instance Demo
# Default (Backend 1): Visiting the app normally connects to this backend
VITE_BACKEND_URL=http://localhost:3001

# Backend 2: Visiting the app with ?server=2 in the URL connects to this backend
# This proves cross-node Socket.IO Redis Pub/Sub sync in a browser-visible way
VITE_BACKEND_URL_2=http://localhost:3002
