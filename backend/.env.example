# Server Environment Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
# Local Docker Postgres:
DATABASE_URL="postgresql://bidwire:bidwire_pass@localhost:5433/bidwire_db?schema=public"
# Cloud Postgres (Supabase Transaction Pooler URI):
# DATABASE_URL="postgresql://postgres.[REF]:[PASS]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Redis Configuration
# Local Redis:
REDIS_URL="redis://localhost:6379"
# Cloud Redis (Upstash TLS URI):
# REDIS_URL="rediss://default:[PASS]@[ENDPOINT].upstash.io:6379"

# CORS Configuration
CORS_ORIGIN="http://localhost:5173"
