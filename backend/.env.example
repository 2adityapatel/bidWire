# Server
PORT=3001
NODE_ENV=development

# Database (Docker Postgres)
DATABASE_URL="postgresql://bidwire:bidwire_pass@localhost:5432/bidwire_db?schema=public"

# Redis (Upstash or local)
# For local development you can leave REDIS_URL empty and the app will skip the Redis adapter
REDIS_URL=""

# Frontend origin (for CORS)
CORS_ORIGIN="http://localhost:5173"
